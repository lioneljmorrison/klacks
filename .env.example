# klacks configuration. Copy to .env (git-ignored); the Makefile loads it.
# Defaults below match the Docker Compose stack (`make up`).

KLACKS_ENV=dev
KLACKS_LOG_LEVEL=info
# KLACKS_LOG_FORMAT=text          # text or json; defaults to json when KLACKS_ENV=prod
KLACKS_HTTP_ADDR=:8080
# KLACKS_HTTP_SHUTDOWN_TIMEOUT=20s
# KLACKS_HTTP_DRAIN_DELAY=0s      # e.g. 5s behind a load balancer
# KLACKS_HTTP_READY_TIMEOUT=2s

KLACKS_POSTGRES_DSN=postgres://klacks:klacks@localhost:55432/klacks?sslmode=disable

KLACKS_SCYLLA_HOSTS=localhost:9042
KLACKS_SCYLLA_KEYSPACE=klacks
# KLACKS_SCYLLA_REPLICATION_FACTOR=1
# KLACKS_SCYLLA_USERNAME=
# KLACKS_SCYLLA_PASSWORD=
# KLACKS_SCYLLA_TIMEOUT=5s

# Optional JSON config file, layered under the env vars above.
# KLACKS_CONFIG=klacks.json
